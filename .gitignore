*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==============================================================================
# Virtual Environments
# ==============================================================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# IDEs and Editors
# ==============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ==============================================================================
# Pytest, Logs & Caches
# ==============================================================================
.pytest_cache/
.coverage
htmlcov/
.cache/
.frame_cache/
*.pkl
*.pickle
*.log

# ==============================================================================
# Media & Binary Files (Prevent pushing large video/audio into Git)
# ==============================================================================
*.mp4
*.mkv
*.avi
*.mov
*.flv
*.wmv
*.wav
*.mp3
*.flac
*.aac
*.m4a
*.ts

# Root-level benchmark scratch renders & sample test images
compare_*.jpg
compare_*.png
preview_render_*.jpg
preview_render_*.png
frame_*.jpg
frame_*.png
rendered_*.jpg
rendered_*.png
test_*.jpg
test_*.png
ass_opt*.ass
test_exact_match.ass

# Benchmark intermediate caches & heavy samples
bench/mask_samples/
bench/*.png
bench/*.jpg
bench/fixtures/reference/asr_1080p/*.wav

# ==============================================================================
# Runtime & Work Directories
# ==============================================================================
work_tasks/
work_*/
output/
ocr_output/
logs/
logs_ocr/

# Preserve input directory skeletons
!input/
!input/.gitkeep
!ocr_input/
!ocr_input/.gitkeep
