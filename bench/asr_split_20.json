[
  {
    "start": 1.39,
    "end": 2.05,
    "text": "안녕하세요."
  },
  {
    "start": 2.35,
    "end": 4.23,
    "text": "오늘도 좋은 하루 되세요."
  },
  {
    "start": 6.39,
    "end": 7.79,
    "text": "정말 감사합니다."
  },
  {
    "start": 10.48,
    "end": 11.68,
    "text": "조심해서 들어가."
  },
  {
    "start": 14.0,
    "end": 15.72,
    "text": "잠깐만 기다려봐."
  },
  {
    "start": 17.73,
    "end": 19.33,
    "text": "이게 무슨 일이야?"
  },
  {
    "start": 21.7,
    "end": 24.46,
    "text": "민수 형, 오늘 저녁에 시간 있어?"
  },
  {
    "start": 26.8,
    "end": 29.98,
    "text": "지훈 오빠, 나 이 영화 보고 싶어."
  },
  {
    "start": 32.14,
    "end": 34.94,
    "text": "수진 누나, 이번 주말에 약속 있어?"
  },
  {
    "start": 37.43,
    "end": 40.01,
    "text": "지혜 언니, 같이 쇼핑하러 가자."
  },
  {
    "start": 41.87,
    "end": 45.59,
    "text": "박선배, 과제 좀 도와주실 수 있나요?"
  },
  {
    "start": 47.66,
    "end": 50.42,
    "text": "아저씨, 시청 앞까지 가주세요."
  },
  {
    "start": 52.73,
    "end": 56.09,
    "text": "현우야, 저기 있는 김팀장님 불러와."
  },
  {
    "start": 58.1,
    "end": 61.28,
    "text": "이모, 여기 김치찌개 하나 더 주세요."
  },
  {
    "start": 63.92,
    "end": 64.92,
    "text": "처음 뵙겠습니다."
  },
  {
    "start": 65.82,
    "end": 67.34,
    "text": "잘 부탁드립니다."
  },
  {
    "start": 69.6,
    "end": 73.08,
    "text": "이번 프로젝트에 적극적으로 동참해 주십시오."
  },
  {
    "start": 75.12,
    "end": 76.74,
    "text": "회의를 시작하겠습니다."
  },
  {
    "start": 77.52,
    "end": 79.58,
    "text": "자리에 앉아 주십시오."
  },
  {
    "start": 81.52,
    "end": 84.36,
    "text": "오늘 날씨가 정말 맑고 따뜻해요."
  },
  {
    "start": 86.72,
    "end": 90.12,
    "text": "선생님, 이 부분은 어떻게 이해하면 될까요?"
  },
  {
    "start": 92.29,
    "end": 94.91,
    "text": "저는 내일 부산으로 출장을 가요."
  },
  {
    "start": 97.54,
    "end": 99.46,
    "text": "얘야, 너 지금 어디 가냐?"
  }
]