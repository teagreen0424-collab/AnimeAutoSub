[
  {
    "start": 21.04,
    "end": 23.02,
    "text": "はい、動画消したぜ。"
  },
  {
    "start": 24.33,
    "end": 31.53,
    "text": "はぁ、一生もんのおかずがパーだわ。その分今日は思いっきりやらせてもらうからな。"
  },
  {
    "start": 32.76,
    "end": 37.52,
    "text": "さ、最後だからって、まさかラブホテルでなんて。"
  },
  {
    "start": 39.51,
    "end": 43.99,
    "text": "やっべ、シャワー浴びためぐみさんくっそいい匂いする。"
  },
  {
    "start": 43.99,
    "end": 50.95,
    "text": "ああこれが最後のセックスとか もっとめぐみさんとエッチしてよ"
  },
  {
    "start": 50.95,
    "end": 57.77,
    "text": "毎日抱きて抱かせろ ほら最後にしっかりラブラブすんぞ"
  },
  {
    "start": 57.77,
    "end": 60.43,
    "text": "覚悟しろよ"
  },
  {
    "start": 60.43,
    "end": 69.74,
    "text": "これで絶対に最後だから"
  },
  {
    "start": 69.74,
    "end": 76.72,
    "text": "このうちに触れるのも最後 どうに最後"
  },
  {
    "start": 76.72,
    "end": 82.22,
    "text": "めぐみさん息荒すぎだろ"
  },
  {
    "start": 82.22,
    "end": 89.04,
    "text": "あんなにやらしいキスされたら"
  },
  {
    "start": 89.04,
    "end": 93.54,
    "text": "くそなんで生ハメじゃねえんだよ最後だぞ"
  },
  {
    "start": 93.54,
    "end": 98.64,
    "text": "抱きちゃったら取り返しが"
  },
  {
    "start": 98.64,
    "end": 102.88,
    "text": "ラブラブ交尾に正論を持ち込むな"
  },
  {
    "start": 102.88,
    "end": 108.56,
    "text": "おいおい即行きかよ"
  },
  {
    "start": 108.56,
    "end": 114.88,
    "text": "マンクの方はゴムなしがいいってよ"
  },
  {
    "start": 114.88,
    "end": 121.88,
    "text": "終わりに上の口でたっぷり粘膜こすり合うぞ 来たぞよ"
  },
  {
    "start": 121.88,
    "end": 129.61,
    "text": "こんな全身が密着したエッチ"
  },
  {
    "start": 129.61,
    "end": 134.83,
    "text": "イマイチしちゃいけないのに 一発抜ける"
  },
  {
    "start": 134.83,
    "end": 136.73,
    "text": "ダメだエッグザ"
  },
  {
    "start": 136.73,
    "end": 146.12,
    "text": "ラブラブセックスで"
  },
  {
    "start": 146.12,
    "end": 159.69,
    "text": "いいスタート切ったな"
  },
  {
    "start": 159.69,
    "end": 165.53,
    "text": "ほらお前の中を泳ぎたかった精子だぞ さぞかし無念だろ"
  },
  {
    "start": 165.53,
    "end": 170.31,
    "text": "まだまだ出すから 一発ずつ目に焼き付けろよ"
  },
  {
    "start": 170.31,
    "end": 174.49,
    "text": "コンドームがこんなにパンパンに"
  },
  {
    "start": 174.49,
    "end": 186.72,
    "text": "うわっ ケツの迫力やっべ"
  },
  {
    "start": 186.72,
    "end": 192.54,
    "text": "このデカケツも今日で見納めかよ マジ納得いかねえ"
  },
  {
    "start": 192.54,
    "end": 199.15,
    "text": "やっぱ結婚しよう"
  },
  {
    "start": 199.15,
    "end": 201.79,
    "text": "夫婦になって毎日ハメよう"
  },
  {
    "start": 201.79,
    "end": 209.0,
    "text": "じゃあおまんこだけ"
  },
  {
    "start": 209.0,
    "end": 211.44,
    "text": "不倫で趣味でいいか"
  },
  {
    "start": 211.44,
    "end": 221.32,
    "text": "あ、くそ、こんだけハメてるのになんて強調なんだ"
  },
  {
    "start": 221.32,
    "end": 234.55,
    "text": "ラブホテルにまで来ていてわがまま言うな"
  },
  {
    "start": 234.55,
    "end": 237.95,
    "text": "ラブホのラブは愛って意味だろが"
  },
  {
    "start": 237.95,
    "end": 242.49,
    "text": "俺たちはもうラブラブなんだよ"
  },
  {
    "start": 242.49,
    "end": 248.24,
    "text": "ガトマン君にラブラブ誠心出すからな"
  },
  {
    "start": 248.24,
    "end": 264.24,
    "text": "めぐみ好きだ、愛してるぞ"
  },
  {
    "start": 264.24,
    "end": 270.95,
    "text": "なんで私なの?他に若くていい子いっぱい"
  },
  {
    "start": 270.95,
    "end": 279.24,
    "text": "ふざけんな!こんなお一人上品の美人妻で評判なくせに"
  },
  {
    "start": 279.24,
    "end": 284.78,
    "text": "裏にはどっせべ下品なお亡くるいのメスや そうそういる"
  },
  {
    "start": 284.78,
    "end": 288.67,
    "text": "セキュリティレスもほとんどにしとけ"
  },
  {
    "start": 288.67,
    "end": 292.84,
    "text": "でもそのメグミさん好き"
  },
  {
    "start": 292.84,
    "end": 306.57,
    "text": "私は"
  },
  {
    "start": 306.57,
    "end": 319.35,
    "text": "最後かよ"
  },
  {
    "start": 319.35,
    "end": 323.62,
    "text": "やっぱラストは種付けプレスだな"
  },
  {
    "start": 324.8,
    "end": 327.2,
    "text": "一番好ピッチで感じたわ"
  },
  {
    "start": 327.2,
    "end": 336.45,
    "text": "ガリガリ"
  },
  {
    "start": 336.45,
    "end": 350.83,
    "text": "めぐみさん俺のことずっとでも"
  },
  {
    "start": 350.83,
    "end": 386.84,
    "text": "愛をささやかれて生きていったかよ"
  },
  {
    "start": 386.84,
    "end": 389.21,
    "text": "俺のせいかし"
  },
  {
    "start": 389.21,
    "end": 404.26,
    "text": "褒められながらの"
  },
  {
    "start": 404.26,
    "end": 411.79,
    "text": "雑誌が来た"
  },
  {
    "start": 411.79,
    "end": 413.01,
    "text": "最後に"
  },
  {
    "start": 413.01,
    "end": 429.61,
    "text": "最後にふさわしく大量"
  },
  {
    "start": 429.61,
    "end": 434.28,
    "text": "名残惜しいが いいセックスだったわ"
  },
  {
    "start": 434.28,
    "end": 440.91,
    "text": "この思い出とともに生きていこうな またやりたくなったら いつでも呼んで"
  },
  {
    "start": 440.91,
    "end": 459.26,
    "text": "それからしばらくして"
  },
  {
    "start": 459.26,
    "end": 464.96,
    "text": "後ろめたさを残しつつも ター君と二人の生活に戻ることができた"
  },
  {
    "start": 464.96,
    "end": 469.6,
    "text": "と思ったのに ター君は最近"
  },
  {
    "start": 469.6,
    "end": 474.69,
    "text": "お家でも忙しそうにしています ねえ"
  },
  {
    "start": 474.69,
    "end": 479.91,
    "text": "忙しいのはわかるけど よかったら"
  },
  {
    "start": 479.91,
    "end": 485.84,
    "text": "久々に 悪い 後でな 後でって"
  },
  {
    "start": 485.84,
    "end": 488.42,
    "text": "いつなのよ"
  },
  {
    "start": 488.42,
    "end": 493.76,
    "text": "あれから"
  },
  {
    "start": 493.76,
    "end": 497.48,
    "text": "つよし君はずっとこんな画像を送り続けてきます"
  },
  {
    "start": 497.48,
    "end": 513.18,
    "text": "おっとチンチンが大きいだけのくせに"
  },
  {
    "start": 513.18,
    "end": 517.36,
    "text": "バカにして つよし君のチンポなんていらないんだから"
  },
  {
    "start": 517.36,
    "end": 520.5,
    "text": "私には"
  },
  {
    "start": 520.5,
    "end": 546.98,
    "text": "めぐみどうしたんだその格好"
  },
  {
    "start": 546.98,
    "end": 553.89,
    "text": "最近お仕事ばっかりだから 少し休んで"
  },
  {
    "start": 553.89,
    "end": 557.39,
    "text": "う、うちしよう うちしよう"
  },
  {
    "start": 558.99,
    "end": 564.99,
    "text": "私が上になるから ちょ、めぐみ"
  },
  {
    "start": 564.99,
    "end": 571.48,
    "text": "ごめん もしもし はい"
  },
  {
    "start": 571.48,
    "end": 574.56,
    "text": "わかりました"
  },
  {
    "start": 574.56,
    "end": 581.0,
    "text": "ちょっと外で仕事してくるよ"
  },
  {
    "start": 581.0,
    "end": 585.32,
    "text": "めぐみ こういう下品なこと"
  },
  {
    "start": 585.32,
    "end": 595.01,
    "text": "君らしくないよ"
  },
  {
    "start": 595.01,
    "end": 601.02,
    "text": "すっかり遅くなっちゃったな めぐみ 様子が変だったな"
  },
  {
    "start": 601.02,
    "end": 605.1,
    "text": "びっくりして出てきちゃったけど 一回ちゃんと話すか"
  },
  {
    "start": 605.1,
    "end": 608.72,
    "text": "ただいま"
  },
  {
    "start": 608.72,
    "end": 614.48,
    "text": "なんだこの音"
  },
  {
    "start": 614.48,
    "end": 621.36,
    "text": "なんで寝室から めぐみがAVか何か見てるのか まさかな"
  },
  {
    "start": 621.36,
    "end": 631.61,
    "text": "めぐみなんでよくんとセックスしてるんだ"
  },
  {
    "start": 631.61,
    "end": 636.39,
    "text": "まさかネイペン"
  },
  {
    "start": 636.39,
    "end": 641.65,
    "text": "だったらめぐみはなんでこんな顔"
  },
  {
    "start": 641.65,
    "end": 646.67,
    "text": "いやめぐみさんから誘ってくれるとかマジ感動"
  },
  {
    "start": 646.67,
    "end": 653.19,
    "text": "連絡もらって部屋に行ったら正直びっくりしたわ"
  },
  {
    "start": 653.19,
    "end": 659.41,
    "text": "玄関中にメフシューが充満してんの もう速攻でフルボッキー"
  },
  {
    "start": 659.41,
    "end": 664.75,
    "text": "不幸よすぎて罠かよってな でも顔見た人安心"
  },
  {
    "start": 664.75,
    "end": 670.88,
    "text": "ぼっきちんぽに目がくきづけ もうやることしか頭にねえの"
  },
  {
    "start": 670.88,
    "end": 673.46,
    "text": "ごみなしもOKしてくれたし"
  },
  {
    "start": 673.46,
    "end": 678.9,
    "text": "旦那さん"
  },
  {
    "start": 678.9,
    "end": 684.35,
    "text": "めぐみさん もう俺のデカチン中毒になっちゃった"
  },
  {
    "start": 684.35,
    "end": 687.06,
    "text": "めぐみから誘った"
  },
  {
    "start": 687.06,
    "end": 693.51,
    "text": "おいおいおい 寝てから集めきすぎだろ"
  },
  {
    "start": 693.51,
    "end": 697.55,
    "text": "おっとりふわとまると ぎゅーし 嫌だ"
  },
  {
    "start": 697.55,
    "end": 706.62,
    "text": "俺ももう行くわ"
  },
  {
    "start": 706.62,
    "end": 713.6,
    "text": "このまま中に立つからね ほら 中?"
  },
  {
    "start": 714.36,
    "end": 718.32,
    "text": "ダメだろそんなの やめてくれ レグビー"
  },
  {
    "start": 718.32,
    "end": 733.42,
    "text": "もう"
  },
  {
    "start": 733.42,
    "end": 738.28,
    "text": "レグビー なんで"
  },
  {
    "start": 738.28,
    "end": 744.75,
    "text": "くそ なんであんなガキに妻をいいようにされてるんだ 生ハメコビだからね"
  },
  {
    "start": 744.75,
    "end": 746.67,
    "text": "あんなやつ蹴り飛ばして恵みを"
  },
  {
    "start": 746.67,
    "end": 752.23,
    "text": "なんだあの大きさ"
  },
  {
    "start": 752.23,
    "end": 756.67,
    "text": "俺のと全然違う あんなものが恵みの中に"
  },
  {
    "start": 756.67,
    "end": 762.65,
    "text": "やっぱ生ハメコビたまんねえ 勃起収まる気配ねえわ"
  },
  {
    "start": 762.65,
    "end": 769.3,
    "text": "今日は絶対腹もせっからな 覚悟しろよ"
  },
  {
    "start": 769.3,
    "end": 775.16,
    "text": "待ってた"
  },
  {
    "start": 775.16,
    "end": 780.23,
    "text": "恵みを取り返さないと やめないといけないのに なんで"
  },
  {
    "start": 780.23,
    "end": 788.73,
    "text": "なんでそんな顔してるんだ"
  },
  {
    "start": 788.73,
    "end": 804.84,
    "text": "あ、めぐみと目が合った。覗いてるのがバレた。俺に気づいた。もし、目に気づいているのに。"
  },
  {
    "start": 806.92,
    "end": 821.82,
    "text": "しっかりラブラブだな。俺のことはめぐみみたいな下品なドッキリ女好き。"
  },
  {
    "start": 827.23,
    "end": 837.02,
    "text": "お前、俺のメスだよな。このちんぽ大好きだろ。じゃあ、旦那と別れねえとな。"
  },
  {
    "start": 837.02,
    "end": 845.97,
    "text": "この国では夫は二人もいらねーんだよ"
  },
  {
    "start": 845.97,
    "end": 852.81,
    "text": "子宮はもう答え出してんだろ コリッコリのお口をほぐしてくれた方がいいってよ"
  },
  {
    "start": 852.81,
    "end": 857.17,
    "text": "ほら仕事してる旦那に謝れよ"
  },
  {
    "start": 857.17,
    "end": 860.93,
    "text": "できたらとびっきりの仲出しくれてやっからよ"
  },
  {
    "start": 860.93,
    "end": 942.42,
    "text": "ああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああ"
  },
  {
    "start": 942.42,
    "end": 944.62,
    "text": "つよしさん"
  },
  {
    "start": 949.39,
    "end": 954.75,
    "text": "俺たちはあっさりと別れた あんなものを見せつけられて"
  },
  {
    "start": 954.75,
    "end": 961.01,
    "text": "夫婦としてやっていく自信はなかった 医者料は向こうから支払ってきた"
  },
  {
    "start": 961.01,
    "end": 967.74,
    "text": "想定の倍の金額だった つよし君の父は成功した経営者らしく"
  },
  {
    "start": 967.74,
    "end": 971.22,
    "text": "息子の結婚祝いと言わんばかりだった"
  },
  {
    "start": 971.22,
    "end": 975.83,
    "text": "この部屋にめぐみはもういない"
  },
  {
    "start": 975.83,
    "end": 979.3,
    "text": "しかし遠くへ行ったわけじゃない"
  },
  {
    "start": 979.3,
    "end": 985.86,
    "text": "めぐみは隣で生活している"
  },
  {
    "start": 985.86,
    "end": 995.73,
    "text": "俺は今さら以前隣から響いてきた動画の声が"
  },
  {
    "start": 995.73,
    "end": 998.09,
    "text": "恵のものだと気づいた"
  },
  {
    "start": 998.09,
    "end": 1005.48,
    "text": "四六時中薄い壁から肉がぶつかり合う音が響いてくる"
  },
  {
    "start": 1005.48,
    "end": 1009.26,
    "text": "ジオシ君のあの巨魂にはそれが当然という気がした"
  },
  {
    "start": 1009.26,
    "end": 1012.7,
    "text": "自分には到底真似できない"
  },
  {
    "start": 1012.7,
    "end": 1018.2,
    "text": "こんな風にメスを満足させることなど"
  },
  {
    "start": 1020.14,
    "end": 1024.12,
    "text": "今にして思えば恵の不倫を目撃したあの時"
  },
  {
    "start": 1024.12,
    "end": 1027.16,
    "text": "動けなかったのか"
  },
  {
    "start": 1027.16,
    "end": 1033.11,
    "text": "明白だった"
  },
  {
    "start": 1033.11,
    "end": 1037.88,
    "text": "そうだゴミ出し"
  },
  {
    "start": 1037.88,
    "end": 1047.42,
    "text": "ゴミ出しご苦労様"
  },
  {
    "start": 1047.42,
    "end": 1054.06,
    "text": "いい天気ね あの 音とか大丈夫かな"
  },
  {
    "start": 1054.06,
    "end": 1058.04,
    "text": "うるさくしてたらごめんね もう"
  },
  {
    "start": 1058.04,
    "end": 1064.55,
    "text": "今お隣さんに挨拶中でしょ 強しちゃったら"
  },
  {
    "start": 1064.55,
    "end": 1071.41,
    "text": "妊娠して おっぱい系日に乗れと さらに求めてきて ゴミもティッシュばかりで"
  },
  {
    "start": 1071.41,
    "end": 1075.93,
    "text": "恥ずかしいわ つよしさん、今日のご飯は何がいい?"
  },
  {
    "start": 1075.93,
    "end": 1078.93,
    "text": "めぐみ、めぐみ食べる?"
  },
  {
    "start": 1078.93,
    "end": 1082.76,
    "text": "それはずっと食べてるでしょ?"
  },
  {
    "start": 1082.76,
